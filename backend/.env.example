# MongoDB Settings
MONGODB_URL=mongodb://localhost:27017
DATABASE_NAME=forgeroom

# JWT Configuration
# Generate secure keys via openssl rand -hex 32
JWT_SECRET_KEY=your_access_token_secret_key_change_me
JWT_REFRESH_SECRET_KEY=your_refresh_token_secret_key_change_me
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# NVIDIA LLM Settings
NVIDIA_API_KEY=nvapi-your_nvidia_api_key_here
NVIDIA_API_URL=https://integrate.api.nvidia.com/v1
# Model options: meta/llama-3.1-70b-instruct, nvidia/llama-3.1-nemotron-70b-instruct, etc.
NVIDIA_MODEL_NAME=meta/llama-3.1-70b-instruct
